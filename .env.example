# --- LLM provider: local Ollama (OpenAI-compatible) ---
LLM_PROVIDER=openai_compatible
LLM_MODEL=llama3.2
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama            # any non-empty string; Ollama ignores it

# --- LLM provider: Anthropic ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5 # set to a CURRENT model id from Anthropic's docs
# ANTHROPIC_API_KEY=sk-ant-...

# --- harness / loop-engineering knobs ---
MAX_MODEL_ATTEMPTS=3
MAX_CRAG_ROUNDS=2
CRAG_MIN_RELEVANT=2
JUDGE_THRESHOLD=0.75
MAX_ROWS_PER_RESOURCE=500

# --- optional tracing ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=ls-...